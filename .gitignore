# Per-chunk TensorQTL GPU logs: ~6.7 MB each, regenerated every run.
# Applies to new runs only; logs already tracked in history are left in place.
*tensorqtl*.log
cpg_tensorqtl.*.log

# Deterministic per-chromosome intermediates from
# 01_cpg_meqtl_mapping step_2 (cpg_vmr_map) and step_6 (cpg_coverage).
# 528 files / 240 MB, fully regenerable; dropped from tracking 2026-08-15.
# NOTE: only the chr-split bulk is ignored. The covariate model definitions in
# the same directory (covariates_M*.txt, incl. the locked M3a_primary, plus
# latent factors and coverage summaries) stay tracked -- they are the analysis
# design, not intermediates.
meqtl-validation/01_cpg_meqtl_mapping/*/_m/prepared/**/cpg_vmr_map.chr*.tsv
meqtl-validation/01_cpg_meqtl_mapping/*/_m/prepared/**/cpg_coverage.chr*.tsv

